# ── macOS 系统残料 ──
.DS_Store

# ── Python 编译缓存 ──
__pycache__/
*.pyc

# ── 备份文件（时间戳备份不入库）──
*.bak
*.bak.*
*.bak-*

# ── 安装包内时间戳回灌备份目录（不入库）──
记忆琥珀回灌前备份_*/

# ── clock-loop 运行时态（评估时生成，非发布产物）──
.phaseX_last_run.json

# ── 技能运行时日志（含会话 ID，非发布产物）──
*.log

# ── 写入串行锁运行时态（非发布产物）──
.package-lock/

# ── 防回流：占位符同名实体目录（测试副作用落盘物，非发布产物）──
# 注：[ ] 在 gitignore 语法里是字符类，字面方括号必须反斜杠转义，否则规则失效
\[记忆共享中心\]/
